# Copy this file to a new file named ".env" (same folder) and fill in values.
#   Windows:  copy .env.example .env
#   Mac/Linux: cp .env.example .env
SECRET_KEY=CHANGE_THIS_SECRET_KEY_IN_PRODUCTION

# ======================================================================
# OPTION A — MAILTRAP (recommended for the demo / screenshots)
# Mailtrap > Email Testing > Inboxes > your inbox > SMTP Settings
# ======================================================================
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=paste_mailtrap_username_here
SMTP_PASSWORD=paste_mailtrap_password_here
EMAIL_FROM=notifications@blogapi.example.com
EMAIL_FROM_NAME=Blog Management API

# ======================================================================
# OPTION B — GMAIL with an App Password (real inbox delivery)
# Comment out Option A above and use these instead:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=yourname@gmail.com
#   SMTP_PASSWORD=abcdefghijklmnop        <- 16-char App Password (NOT your Gmail password)
#   EMAIL_FROM=yourname@gmail.com         <- must be the same Gmail address
#   EMAIL_FROM_NAME=Blog Management API
# (Port 465 also works — SSL is switched on automatically.)
# ======================================================================

# Optional
TIMEZONE=Asia/Kolkata
SMTP_TIMEOUT=15
# Set true only if you want to be emailed about your OWN likes/comments (single-account testing)
NOTIFY_ON_OWN_ACTIVITY=false

# --- AI Support Chat (optional) ---
# Leave blank to use the built-in FAQ responses (no setup needed).
# Set this to use real OpenAI replies instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
